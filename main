    <!-- ═══════════ الخطوة 4: الخبر ═══════════ -->
    <section class="screen" data-step="4">
      <div class="card">
        <div class="badge">🎉 خبر حلو كتير 🎉</div>

        <h2 class="to">لأحلى أب وأم وأخوات 💛</h2>

        <div class="big">
          <span>رح تصيروا</span>
          <strong>جدّو وتيتا</strong>
        </div>

        <div class="emoji-row">👶 🍼 ✨</div>

        <p class="msg">
          قلبنا مليان فرح، ومنستنى هالضيف الصغير بفارغ الصبر.<br>
          الله يتمم على خير ويجعله من الصالحين 🤍
        </p>

        <div class="divider"><span>💛</span></div>

        <p class="from">من: <span class="name">[اكتب اسمك هون]</span></p>

        <button class="btn ghost" id="againBtn" style="margin-top:22px">🔁 شوفوا الخبر مرة تانية</button>
      </div>
    </section>

  </main>

  <!-- تقدم + تخطي -->
  <div class="progress" id="progress" aria-hidden="true">
    <span class="dot"></span>
