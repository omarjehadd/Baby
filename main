<script>
/* ══════════════════════════════════════════
   ١) قلوب الخلفية
   ══════════════════════════════════════════ */
(function createHearts(){
  const box = document.getElementById('bgHearts');
  const glyphs = ['💛','🤍','💗','✨','🍼','👶','💫','🎈'];
  for(let i = 0; i < 18; i++){
    const h = document.createElement('span');
    h.className = 'bg-heart';
    h.textContent = glyphs[Math.floor(Math.random() * glyphs.length)];
    h.style.left = (Math.random() * 100) + 'vw';
    h.style.fontSize = (12 + Math.random() * 20) + 'px';
    h.style.animationDuration = (12 + Math.random() * 14) + 's';
    h.style.animationDelay = (-Math.random() * 24) + 's';
    box.appendChild(h);
  }
})();

/* ══════════════════════════════════════════
   ٢) الكونفيتي
   ══════════════════════════════════════════ */
const COLORS = ['#ff6fa5','#f6c453','#8b7bf7','#66c7f4','#7ce0a3','#ff9f7a','#ffffff'];

function burstConfetti(count){
  const layer = document.getElementById('confetti');
  const total = count || 130;
  const frag = document.createDocumentFragment();

  for(let i = 0; i < total; i++){
    const p = document.createElement('i');
    p.className = 'confetti-piece';

    const size = 6 + Math.random() * 10;
    p.style.left = (Math.random() * 100) + 'vw';
    p.style.width = size + 'px';
    p.style.height = (size * (0.6 + Math.random() * 0.9)) + 'px';
    p.style.background = COLORS[Math.floor(Math.random() * COLORS.length)];
    p.style.animationDuration = (2.6 + Math.random() * 2.8) + 's';
    p.style.animationDelay = (Math.random() * 1.4) + 's';
    p.style.opacity = (0.7 + Math.random() * 0.3).toFixed(2);

    if(Math.random() > 0.65) p.style.borderRadius = '50%';
    if(Math.random() > 0.85) p.style.transform = 'rotate(45deg)';

    frag.appendChild(p);
  }

  layer.innerHTML = '';
  layer.appendChild(frag);
  setTimeout(() => { layer.innerHTML = ''; }, 9000);
}

/* ══════════════════════════════════════════
   ٣) التنقل بين الخطوات
   ══════════════════════════════════════════ */
const screens   = document.querySelectorAll('.screen');
const progressEl = document.getElementById('progress');
const dots      = document.querySelectorAll('.dot');
const skipBtn   = document.getElementById('skipBtn');
let currentStep = 0;

function showStep(n){
  currentStep = n;

  screens.forEach(s => {
    s.classList.toggle('active', Number(s.dataset.step) === n);
  });

  // شريط التقدم (يظهر بالخطوات ١-٣)
  progressEl.classList.toggle('show', n >= 1 && n <= 3);
  dots.forEach((d, i) => d.classList.toggle('on', i < n));

  // زر التخطي
  skipBtn.classList.toggle('show', n >= 1 && n <= 3);

  // تجهيز الكشط
  if(n === 3) setTimeout(setupScratch, 80);

  // كونفيتي للخبر النهائي
  if(n === 4){
    burstConfetti(150);
    setTimeout(() => burstConfetti(80), 850);
    try{ if(navigator.vibrate) navigator.vibrate([40, 70, 40, 70, 60]); }catch(e){}
  }

  window.scrollTo({ top: 0, behavior: 'smooth' });
}

/* زر البداية */
document.getElementById('startBtn').addEventListener('click', () => showStep(1));

/* زر التخطي → يروح مباشرة للخبر */
skipBtn.addEventListener('click', () => showStep(4));

/* ══════════════════════════════════════════
   ٤) الخطوة ١ — الظرف
   ══════════════════════════════════════════ */
const envelope = document.getElementById('envelope');
const next1    = document.getElementById('next1');

function openEnvelope(){
  if(envelope.classList.contains('open')) return;
  envelope.classList.add('open');
  try{ if(navigator.vibrate) navigator.vibrate(25); }catch(e){}
  setTimeout(() => next1.classList.remove('hidden'), 950);
}

envelope.addEventListener('click', openEnvelope);
envelope.addEventListener('keydown', e => {
  if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); openEnvelope(); }
});
next1.addEventListener('click', () => showStep(2));

/* ══════════════════════════════════════════
   ٥) الخطوة ٢ — البالونات
   ══════════════════════════════════════════ */
const balloons = document.querySelectorAll('.balloon');
const slots    = document.querySelectorAll('.slot');
const next2    = document.getElementById('next2');
let poppedCount = 0;

balloons.forEach(b => {
  b.addEventListener('click', () => {
    if(b.classList.contains('popped')) return;
    b.classList.add('popped');
    try{ if(navigator.vibrate) navigator.vibrate(18); }catch(e){}

    const i = Number(b.dataset.i);
    const slot = slots[i];
    if(slot && !slot.classList.contains('filled')){
      slot.textContent = b.dataset.letter;
      slot.classList.add('filled');
    }

    poppedCount++;
    if(poppedCount === balloons.length){
      setTimeout(() => {
        next2.classList.remove('hidden');
        burstConfetti(50);
      }, 420);
    }
  });
});
next2.addEventListener('click', () => showStep(3));

/* ══════════════════════════════════════════
   ٦) الخطوة ٣ — بطاقة الكشط
   ══════════════════════════════════════════ */
const scratchCanvas = document.getElementById('scratchCanvas');
const next3         = document.getElementById('next3');
const revealNowBtn  = document.getElementById('revealNow');
let scratchReady    = false;
let scratchDone     = false;

function setupScratch(){
  if(scratchReady || scratchDone) return;
  scratchReady = true;

  const wrap = scratchCanvas.parentElement;
  const rect = wrap.getBoundingClientRect();
  if(!rect.width){ scratchReady = false; setTimeout(setupScratch, 120); return; }

  const dpr = window.devicePixelRatio || 1;
  scratchCanvas.width  = Math.round(rect.width  * dpr);
  scratchCanvas.height = Math.round(rect.height * dpr);

  const ctx = scratchCanvas.getContext('2d');
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

  // طبقة الكشط
  const g = ctx.createLinearGradient(0, 0, rect.width, rect.height);
  g.addColorStop(0,   '#d8c9f2');
  g.addColorStop(0.5, '#f3c9de');
  g.addColorStop(1,   '#f8ddb3');
  ctx.fillStyle = g;
  ctx.fillRect(0, 0, rect.width, rect.height);

  // نجوم خفيفة
  ctx.fillStyle = 'rgba(255,255,255,.55)';
  for(let i = 0; i < 40; i++){
    const x = Math.random() * rect.width;
    const y = Math.random() * rect.height;
    const r = Math.random() * 1.8 + 0.4;
    ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
  }

  // النص الإرشادي
  ctx.fillStyle = 'rgba(255,255,255,.92)';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.font = '800 17px Cairo, sans-serif';
  ctx.fillText('اكشطوا بإصبعكم 🪙', rect.width / 2, rect.height / 2);

  ctx.globalCompositeOperation = 'destination-out';

  let drawing = false;
  let last = { x: 0, y: 0 };
  let moveCount = 0;

  function getPos(e){
    const r = scratchCanvas.getBoundingClientRect();
    return { x: e.clientX - r.left, y: e.clientY - r.top };
  }

  function punch(x, y){
    ctx.beginPath();
    ctx.arc(x, y, 24, 0, Math.PI * 2);
    ctx.fill();
  }

  function progress(){
    if(scratchDone) return;
    const data = ctx.getImageData(0, 0, scratchCanvas.width, scratchCanvas.height).data;
    let clear = 0;
    const total = data.length / 4;
    for(let i = 3; i < data.length; i += 16){   // كل ٤ بكسل (تسريع)
      if(data[i] < 40) clear++;
    }
    // لأننا نفحص ١ من كل ٤، النسبة تضرب بـ ٤
    const ratio = (clear * 4) / total;
    if(ratio > 0.52) finishScratch();
  }

  scratchCanvas.addEventListener('pointerdown', e => {
    if(scratchDone) return;
    drawing = true;
    try{ scratchCanvas.setPointerCapture(e.pointerId); }catch(err){}
    last = getPos(e);
    punch(last.x, last.y);
  });

  scratchCanvas.addEventListener('pointermove', e => {
    if(!drawing || scratchDone) return;
    e.preventDefault();
    const p = getPos(e);
    const dx = p.x - last.x;
    const dy = p.y - last.y;
    const dist = Math.hypot(dx, dy);
    const steps = Math.max(1, Math.ceil(dist / 7));

    for(let i = 1; i <= steps; i++){
      punch(last.x + dx * i / steps, last.y + dy * i / steps);
    }

    last = p;
    moveCount++;
    if(moveCount % 7 === 0) progress();
  });

  ['pointerup', 'pointercancel', 'pointerleave'].forEach(ev => {
    scratchCanvas.addEventListener(ev, () => {
      if(!drawing) return;
      drawing = false;
      progress();
    });
  });
}

function finishScratch(){
  if(scratchDone) return;
  scratchDone = true;
  scratchCanvas.classList.add('gone');
  burstConfetti(60);
  try{ if(navigator.vibrate) navigator.vibrate([25, 50, 25]); }catch(e){}
  setTimeout(() => next3.classList.remove('hidden'), 500);
}

revealNowBtn.addEventListener('click', () => {
  if(!scratchReady) setupScratch();
  finishScratch();
});

next3.addEventListener('click', () => showStep(4));

/* ══════════════════════════════════════════
   ٧) إعادة العرض
   ══════════════════════════════════════════ */
document.getElementById('againBtn').addEventListener('click', () => {
  // الظرف
  envelope.classList.remove('open');
  next1.classList.add('hidden');

  // البالونات
  poppedCount = 0;
  balloons.forEach(b => b.classList.remove('popped'));
  slots.forEach(s => { s.classList.remove('filled'); s.textContent = '؟'; });
  next2.classList.add('hidden');

  // الكشط
  scratchReady = false;
  scratchDone  = false;
  scratchCanvas.classList.remove('gone');
  const ctx = scratchCanvas.getContext('2d');
  ctx.setTransform(1, 0, 0, 1, 0, 0);
  ctx.clearRect(0, 0, scratchCanvas.width, scratchCanvas.height);
  ctx.globalCompositeOperation = 'source-over';
  next3.classList.add('hidden');

  // الكونفيتي
  document.getElementById('confetti').innerHTML = '';

  showStep(0);
});

/* أول تشغيل */
showStep(0);
</script>
</body>
</html>
